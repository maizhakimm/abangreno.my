# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets to version control.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVICE ROLE KEY — server-side only, NEVER expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare Turnstile (anti-spam for guest forum posts) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Misc ---
# Salt used when hashing IPs for forum rate-limiting (lib/moderation/rateLimit.ts)
IP_HASH_SALT=change-this-to-a-random-string

# --- Future: Cloudflare Stream (vendor video uploads, not implemented in MVP) ---
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
